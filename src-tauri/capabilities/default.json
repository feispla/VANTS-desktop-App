{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos del cliente VANTCALL Desktop para OAuth, sesión segura y SQLite local.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "opener:default",
    "stronghold:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
